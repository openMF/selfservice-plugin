<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Catalog of onboarding steps (tenant-configurable) -->
    <changeSet author="fineract" id="ss-0068-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_selfservice_onboarding_step_def"/>
            </not>
        </preConditions>
        <createTable tableName="m_selfservice_onboarding_step_def">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="step_code" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="step_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(512)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="is_required" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="group_code" type="VARCHAR(64)"/>
            <column name="metadata_json" type="TEXT"/>
        </createTable>
        <createIndex tableName="m_selfservice_onboarding_step_def" indexName="idx_ss_onb_def_order">
            <column name="step_order"/>
        </createIndex>
    </changeSet>

    <!-- Seed Apolo enrollment steps -->
