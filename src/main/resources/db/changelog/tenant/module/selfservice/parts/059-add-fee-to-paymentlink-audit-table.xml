<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="fineract" id="ss-0059-1">
        <preConditions onFail="MARK_RAN">
            <and>
                <not>
                    <columnExists tableName="m_selfservice_payment_link" columnName="fee_amount"/>
                </not>
                <not>
                    <columnExists tableName="m_selfservice_payment_link" columnName="currency_fee"/>
                </not>
            </and>
        </preConditions>

        <comment>Add fee_amount and currency_fee columns to m_selfservice_payment_link</comment>

        <addColumn tableName="m_selfservice_payment_link">
            <column name="fee_amount" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="currency_fee" type="VARCHAR(50)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>