            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_ENROLLMENT_TOKEN_EMAIL'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/> <!-- 0 = CLIENT -->
            <column name="type" valueNumeric="1"/> <!-- 1 = EMAIL -->
            <column name="name" value="SELF_SERVICE_ENROLLMENT_TOKEN_EMAIL"/>
            <column name="text" value="&lt;p&gt;Hello ${firstname},&lt;/p&gt;&lt;p&gt;To create a user, use the following details:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Request ID:&lt;/strong&gt; ${requestId}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Authorization Code:&lt;/strong&gt; ${authCode}&lt;/p&gt;&lt;p&gt;Regards,&lt;br/&gt;The Institution Team&lt;/p&gt;"/>
        </insert>
    </changeSet>

