<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="fineract" id="ss-0022-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="self_service_auth_token"/>
            </not>
        </preConditions>
        <createTable tableName="self_service_auth_token">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="fineract" id="ss-0022-2">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="self_service_auth_token" indexName="idx_self_service_auth_token_expires"/>
            </not>
        </preConditions>
        <createIndex tableName="self_service_auth_token" indexName="idx_self_service_auth_token_expires">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>
    
    <changeSet author="fineract" id="ss-0022-3">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="self_service_auth_token" columnName="token_type"/>
            </not>
        </preConditions>
        <addColumn tableName="self_service_auth_token">
            <column name="token_type" type="VARCHAR(20)" defaultValue="ACCESS">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>