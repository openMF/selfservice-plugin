<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="ss-0049-1-1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM c_external_service WHERE name = 'INSTITUTION_ACCOUNT_FOR_FEES'
                </sqlCheck>
            </not>
        </preConditions>
        
        <insert tableName="c_external_service">
            <column name="name" value="INSTITUTION_ACCOUNT_FOR_FEES"/>
        </insert>
    </changeSet>

    <changeSet id="ss-0049-1-2" author="fineract">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM c_external_service_properties esp 
                    WHERE esp.name = 'INSTITUTION_ACCOUNT_FOR_FEES' 
                </sqlCheck>
            </not>
        </preConditions>

        <insert tableName="c_external_service_properties">
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name='INSTITUTION_ACCOUNT_FOR_FEES')"/>
            <column name="name" value="institution_account_for_fees_enabled"/>
            <column name="value" value="false"/>
        </insert>
        <insert tableName="c_external_service_properties">
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name='INSTITUTION_ACCOUNT_FOR_FEES')"/>
            <column name="name" value="to_office_id"/>
            <column name="value" value="1"/>
        </insert>
        <insert tableName="c_external_service_properties">
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name='INSTITUTION_ACCOUNT_FOR_FEES')"/>
            <column name="name" value="to_client_id"/>
            <column name="value" value="1"/>
        </insert>
        <insert tableName="c_external_service_properties">
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name='INSTITUTION_ACCOUNT_FOR_FEES')"/>
            <column name="name" value="to_account_type"/>
            <column name="value" value="2"/>
        </insert>
        <insert tableName="c_external_service_properties">
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name='INSTITUTION_ACCOUNT_FOR_FEES')"/>
            <column name="name" value="to_account_id_crc"/>
            <column name="value" value="0"/>
        </insert>
        <insert tableName="c_external_service_properties">
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name='INSTITUTION_ACCOUNT_FOR_FEES')"/>
            <column name="name" value="to_account_id_usd"/>
            <column name="value" value="0"/>
        </insert>
    </changeSet>
</databaseChangeLog>