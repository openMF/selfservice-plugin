<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="fineract" id="ss-043-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_selfservice_external_transfer_audit"/>
            </not>
        </preConditions>
        
        <comment>Create audit table for external SINPE/PIN/TPT transfers</comment>
        
        <createTable tableName="m_selfservice_external_transfer_audit">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT"/>
            <column name="transfer_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="origin_iban" type="VARCHAR(100)"/>
            <column name="destination_identifier" type="VARCHAR(100)"/>
            <column name="amount" type="DECIMAL(19,6)"/>
            <column name="currency_code" type="VARCHAR(3)"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="response_payload" type="TEXT"/>
            <column name="error_message" type="TEXT"/>
            <!-- MariaDB/MySQL compatible -->
            <column name="created_on_utc" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <createIndex indexName="idx_external_transfer_client_id" tableName="m_selfservice_external_transfer_audit">
            <column name="client_id"/>
        </createIndex>
        <createIndex indexName="idx_external_transfer_type" tableName="m_selfservice_external_transfer_audit">
            <column name="transfer_type"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>