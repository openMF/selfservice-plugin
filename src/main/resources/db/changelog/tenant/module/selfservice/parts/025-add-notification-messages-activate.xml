<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="fineract" id="ss-0023-1">
        <!-- Add initial templates for Self Service notifications-->
        <!-- EMAIL SUBJECTS -->        
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_USER_ACTIVATED_EMAIL_SUBJECT"/>
            <column name="text" value="Account Activated Successfully"/>
        </insert>
        <!-- USER_ACTIVATED Templates -->
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/> <!-- 0 = CLIENT -->
            <column name="type" valueNumeric="1"/> <!-- 1 = EMAIL -->
            <column name="name" value="SELF_SERVICE_USER_ACTIVATED_EMAIL"/>
            <column name="text" value="Hello ${firstname} ${lastname}, your account has been successfully activated. You can now log in to your account."/>
        </insert>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/> <!-- 0 = CLIENT -->
            <column name="type" valueNumeric="0"/> <!-- 0 = SMS -->
            <column name="name" value="SELF_SERVICE_USER_ACTIVATED_SMS"/>
            <column name="text" value="Hi ${firstname}, your account has been successfully activated. Welcome!"/>
        </insert>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/> <!-- 0 = CLIENT -->
            <column name="type" valueNumeric="0"/> <!-- 0 = SMS -->
            <column name="name" value="SELF_SERVICE_USER_ACTIVATED_WHATSAPP"/>
            <column name="text" value="Hello ${firstname}, your account is now active. You can log in at your convenience."/>
        </insert>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/> <!-- 0 = CLIENT -->
            <column name="type" valueNumeric="0"/> <!-- 0 = SMS -->
            <column name="name" value="SELF_SERVICE_USER_ACTIVATED_IN_APP"/>
            <column name="text" value="Account activated successfully for user ${username}."/>
        </insert>
    </changeSet>
</databaseChangeLog>