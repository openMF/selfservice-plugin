    <!--
        MX-488 follow-up (US-E12-02): per-tenant settings of the authenticator app (TOTP), added to
        the SELF_SERVICE_STEP_UP external service created in 083 and read by StepUpSettingsProvider.
        Nothing is read from environment variables, so one tenant can never change another one.
        Each key is added only when it is missing, so a tenant that already changed one keeps it.

        Keys (values outside the allowed range fall back to the defaults below):
          totpEnabled          true|false   the authenticator app is offered     (default false)
                                            needs enabled=true as well. It has its own switch and
                                            does not depend on "channels" (which every tenant got
                                            as SMS,EMAIL from 083, and which means "all channels"
                                            when unset), so one flag turns it on or off.
          totpEncryptionKey    at least 32 characters; protects the secrets of THIS tenant (AES-GCM
                               key is derived from it). Seeded with a placeholder too short to be
                               used, so the feature cannot start without a real key. Treat it like
                               the other external-service secrets (SMTP, SMS): restrict who may
                               read the external service configuration.
          totpIssuer           name the app shows next to the account            (Mifos)
          totpWindowSteps      0..2   30-second steps accepted either side (clock drift)   (1)
          totpMaxFailures      1..10  wrong codes before the authenticator locks           (5)
          totpLockoutSeconds   60..86400                                                   (900)
          recoveryCodeCount    5..20  recovery codes handed out                            (10)
          totpExclusive        true|false  while a user has an active authenticator, SMS and
                               e-mail codes are not offered (SIM-swap protection)          (true)
    -->

    <changeSet id="ss-0089-1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM c_external_service WHERE name = 'SELF_SERVICE_STEP_UP'
            </sqlCheck>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM c_external_service_properties esp
                WHERE esp.name = 'totpEnabled'
                  AND esp.external_service_id = (SELECT id FROM c_external_service WHERE name = 'SELF_SERVICE_STEP_UP')
            </sqlCheck>
        </preConditions>
        <insert tableName="c_external_service_properties">
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name='SELF_SERVICE_STEP_UP')"/>
            <column name="name" value="totpEnabled"/>
            <column name="value" value="false"/>
        </insert>
    </changeSet>

