<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Actualizar plantilla de Asunto de Email -->
    <changeSet author="fineract" id="ss-0041-1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_TRANSFER_SUCCESS_EMAIL_SUBJECT'
            </sqlCheck>
        </preConditions>
        <update tableName="m_template">
            <column name="text" value="Transferencia Exitosa - Ref: ${transferId}"/>
            <where>name = 'SELF_SERVICE_TRANSFER_SUCCESS_EMAIL_SUBJECT'</where each="row"/>
        </update>
    </changeSet>

    <!-- Actualizar plantilla de Cuerpo de Email (Formato HTML mejorado) -->
    <changeSet author="fineract" id="ss-0041-2">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_TRANSFER_SUCCESS_EMAIL'
            </sqlCheck>
        </preConditions>
        <update tableName="m_template">
            <column name="text" value="&lt;html&gt;&lt;body&gt;
&lt;h2&gt;Transferencia Exitosa&lt;/h2&gt;
&lt;p&gt;Estimado/a ${firstname} ${lastname},&lt;/p&gt;
&lt;p&gt;Su transferencia se ha procesado exitosamente.&lt;/p&gt;
&lt;table style='border-collapse: collapse; width: 100%;' border='1'&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Monto:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${transactionAmount}&lt;/td&gt;&lt;/tr&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Descripción:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${transferDescription}&lt;/td&gt;&lt;/tr&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Fecha:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${transactionDate}&lt;/td&gt;&lt;/tr&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Cuenta Origen:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${fromAccountNumber}&lt;/td&gt;&lt;/tr&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Cliente Origen:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${fromClientName}&lt;/td&gt;&lt;/tr&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Oficina Origen:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${fromOfficeName}&lt;/td&gt;&lt;/tr&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Cuenta Destino:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${toAccountNumber}&lt;/td&gt;&lt;/tr&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Cliente Destino:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${toClientName}&lt;/td&gt;&lt;/tr&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Oficina Destino:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${toOfficeName}&lt;/td&gt;&lt;/tr&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;IP de Origen:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${ipAddress}&lt;/td&gt;&lt;/tr&gt;
    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;ID de Transferencia:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${transferId}&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;p&gt;Gracias por usar nuestros servicios.&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;"/>
            <where>name = 'SELF_SERVICE_TRANSFER_SUCCESS_EMAIL'</where>
        </update>
    </changeSet>

    <!-- Actualizar plantilla SMS -->
    <changeSet author="fineract" id="ss-0041-3">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_TRANSFER_SUCCESS_SMS'
            </sqlCheck>
        </preConditions>
        <update tableName="m_template">
            <column name="text" value="Transferencia exitosa. Monto: ${transactionAmount}. De: ${fromClientName} (${fromAccountNumber}) a ${toClientName} (${toAccountNumber}). Fecha: ${transactionDate}. Ref: ${transferId}. IP: ${ipAddress}."/>
            <where>name = 'SELF_SERVICE_TRANSFER_SUCCESS_SMS'</where>
        </update>
    </changeSet>

    <!-- Actualizar plantilla WhatsApp -->
    <changeSet author="fineract" id="ss-0041-4">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_TRANSFER_SUCCESS_WHATSAPP'
            </sqlCheck>
        </preConditions>
        <update tableName="m_template">
            <column name="text" value="✅ *Transferencia Exitosa*\n\nEstimado/a ${firstname},\n\n💰 *Monto:* ${transactionAmount}\n📝 *Descripción:* ${transferDescription}\n📅 *Fecha:* ${transactionDate}\n🏦 *Origen:* ${fromAccountNumber} (${fromClientName} - ${fromOfficeName})\n🎯 *Destino:* ${toAccountNumber} (${toClientName} - ${toOfficeName})\n🌐 *IP:* ${ipAddress}\n🔖 *Ref:* ${transferId}\n\nGracias por usar nuestros servicios."/>
            <where>name = 'SELF_SERVICE_TRANSFER_SUCCESS_WHATSAPP'</where>
        </update>
    </changeSet>

    <!-- Actualizar plantilla In-App -->
    <changeSet author="fineract" id="ss-0041-5">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_TRANSFER_SUCCESS_IN_APP'
            </sqlCheck>
        </preConditions>
        <update tableName="m_template">
            <column name="text" value="Transferencia exitosa de ${transactionAmount} de ${fromAccountNumber} (${fromClientName}) a ${toAccountNumber} (${toClientName}) el ${transactionDate}. Ref: ${transferId}. IP: ${ipAddress}."/>
            <where>name = 'SELF_SERVICE_TRANSFER_SUCCESS_IN_APP'</where>
        </update>
    </changeSet>
</databaseChangeLog>