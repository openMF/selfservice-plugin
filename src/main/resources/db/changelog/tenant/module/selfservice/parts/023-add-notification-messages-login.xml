        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/> <!-- 0 = CLIENT -->
            <column name="type" valueNumeric="1"/> <!-- 0 = SMS (Workaround for missing IN_APP enum) -->
            <column name="name" value="SELF_SERVICE_LOGIN_SUCCESS_IN_APP"/>
