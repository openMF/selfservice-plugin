            <column name="type" valueNumeric="1"/> <!-- 1 = EMAIL -->
            <column name="name" value="SELF_SERVICE_LOGIN_SUCCESS_EMAIL"/>
            <column name="text" value="Hello ${firstname} ${lastname}, you have successfully logged in to your account from IP ${clientIp}. If this was not you, please contact support immediately."/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="ss-0023-1-4">
