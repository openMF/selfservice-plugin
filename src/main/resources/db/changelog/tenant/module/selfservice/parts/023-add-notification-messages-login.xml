<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="fineract" id="ss-0023-1-1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_LOGIN_SUCCESS_EMAIL_SUBJECT'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/> <!-- 0 = CLIENT -->
            <column name="type" valueNumeric="1"/> <!-- 1 = EMAIL -->
            <column name="name" value="SELF_SERVICE_LOGIN_SUCCESS_EMAIL_SUBJECT"/>
            <column name="text" value="Security Notification: Login Successful"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="ss-0023-1-2">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_LOGIN_FAILURE_EMAIL_SUBJECT'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_LOGIN_FAILURE_EMAIL_SUBJECT"/>
            <column name="text" value="Security Alert: Failed Login Attempt"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="ss-0023-1-3">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
