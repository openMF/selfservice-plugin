            <column name="text" value="Hi ${firstname}, failed login attempt detected from ${clientIp}."/>
        </insert>
    </changeSet>
    <!-- WhatsApp Template for Login Success -->
    <changeSet author="fineract" id="ss-0023-1-7">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_LOGIN_SUCCESS_WHATSAPP'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/> <!-- 0 = CLIENT -->
            <column name="type" valueNumeric="1"/> <!-- 0 = SMS (Workaround for missing WHATSAPP enum) -->
            <column name="name" value="SELF_SERVICE_LOGIN_SUCCESS_WHATSAPP"/>
            <column name="text" value="Hello ${firstname}, you have successfully logged in to your account from IP ${clientIp}. If this was not you, please contact support immediately."/>
        </insert>
    </changeSet>

    <!-- In-App Template for Login Success -->
    <changeSet author="fineract" id="ss-0023-1-8">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_LOGIN_SUCCESS_IN_APP'
