<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="ss-0057-1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM c_external_service WHERE name = 'SELF_SERVICE_FEE_CONFIG'
                </sqlCheck>
            </not>
        </preConditions>
        
        <insert tableName="c_external_service">
            <column name="name" value="SELF_SERVICE_FEE_CONFIG"/>
        </insert>
    </changeSet>

    <changeSet id="ss-0057-2" author="fineract">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM c_external_service_properties esp 
                    WHERE esp.name = 'SELF_SERVICE_FEE_CONFIG' 
                </sqlCheck>
            </not>
        </preConditions>

        <insert tableName="c_external_service_properties">
            <column name="external_service_id" valueComputed="(SELECT id FROM c_external_service WHERE name='SELF_SERVICE_FEE_CONFIG')"/>
            <column name="name" value="transfer_fee_enabled"/>
            <column name="value" value="false"/>
        </insert>       
    </changeSet>
</databaseChangeLog>