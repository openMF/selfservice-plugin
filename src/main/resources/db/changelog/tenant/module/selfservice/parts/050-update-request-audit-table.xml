<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="ss-0050-1-1" author="fineract">    
        <comment>Support fast, safe bulk-consume of stale ACCOUNT_TRANSFER OTPs without table scan</comment>
        <createIndex indexName="idx_request_audit_client_type_consumed"
                      tableName="request_audit_table">
            <column name="client_id"/>
            <column name="request_type"/>
            <column name="consumed"/>
            <column name="created_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="ss-0050-1-2" author="fineract">    
        <comment>Track whether the OTP notification event actually reached the dispatch layer, for observability</comment>
        <addColumn tableName="request_audit_table">
            <column name="notification_dispatched_at" type="DATETIME"/>
            <column name="notification_dispatch_error" type="VARCHAR(500)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>