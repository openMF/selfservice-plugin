    <!-- ================= SAVINGS DEPOSIT TEMPLATES ================= -->

    <changeSet author="fineract" id="ss-0044-1-1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_template WHERE name = 'SELF_SERVICE_SAVINGS_DEPOSIT_EMAIL_SUBJECT'</sqlCheck>
        </preConditions>
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_SAVINGS_DEPOSIT_EMAIL_SUBJECT"/>
            <column name="text" value="Savings Deposit Successful - Ref: ${accountNumber}"/>
        </insert>
    </changeSet>

