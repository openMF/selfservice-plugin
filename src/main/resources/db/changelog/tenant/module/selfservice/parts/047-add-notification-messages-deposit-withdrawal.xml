            <column name="text" value="&lt;html&gt;&lt;body&gt;&#10;&lt;h2&gt;Savings Deposit Successful&lt;/h2&gt;&#10;&lt;p&gt;Dear ${firstname} ${lastname},&lt;/p&gt;&#10;&lt;p&gt;A deposit has been successfully made to your savings account.&lt;/p&gt;&#10;&lt;table style='border-collapse: collapse; width: 100%;' border='1'&gt;&#10;    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Amount:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${currency} ${amount}&lt;/td&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Account Number:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${accountNumber}&lt;/td&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td style='padding: 8px;'&gt;&lt;strong&gt;Date:&lt;/strong&gt;&lt;/td&gt;&lt;td style='padding: 8px;'&gt;${transactionDate}&lt;/td&gt;&lt;/tr&gt;&#10;&lt;/table&gt;&#10;&lt;p&gt;Thank you for banking with us.&lt;/p&gt;&#10;&lt;/body&gt;&lt;/html&gt;"/>
