            <column name="code" value="UPDATE_SELFSERVICEUSER"/>
            <column name="entity_name" value="SELFSERVICEUSER"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- ========================================================= -->
    <!-- DELETE_SELFSERVICEUSER                                    -->
    <!-- ========================================================= -->
    <changeSet id="ss-0072-3" author="fineract">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_permission"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_permission WHERE code = 'DELETE_SELFSERVICEUSER'
            </sqlCheck>
        </preConditions>
        <comment>
            Register DELETE permission for Self Service User administration.
        </comment>
        <insert tableName="m_permission">
            <column name="grouping" value="user administration"/>
