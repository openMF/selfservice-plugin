<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!--
        MULTI-TENANT NOTE: This changelog is included in the TENANT changelog master.
        It will be executed against EVERY tenant schema automatically by Fineract's
        multi-tenant Liquibase runner.

        Registers Self Service User administration permissions required by
        back-office staff to manage self-service accounts.
    -->

    <!-- ========================================================= -->
    <!-- READ_SELFSERVICEUSER                                      -->
    <!-- ========================================================= -->
    <changeSet id="ss-0072-1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_permission"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_permission WHERE code = 'READ_SELFSERVICEUSER'
            </sqlCheck>
        </preConditions>
        <comment>
            Register READ permission for Self Service User administration.
        </comment>
        <insert tableName="m_permission">
            <column name="grouping" value="user administration"/>
            <column name="code" value="READ_SELFSERVICEUSER"/>
            <column name="entity_name" value="SELFSERVICEUSER"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- ========================================================= -->
    <!-- UPDATE_SELFSERVICEUSER                                    -->
    <!-- ========================================================= -->
    <changeSet id="ss-0072-2" author="fineract">
        <preConditions onFail="MARK_RAN">
