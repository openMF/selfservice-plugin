            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_permission WHERE code = 'UPDATE_SELFSERVICEUSER'
            </sqlCheck>
        </preConditions>
        <comment>
            Register UPDATE permission for Self Service User administration.
        </comment>
        <insert tableName="m_permission">
