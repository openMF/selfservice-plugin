<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Password Renewed - Notification Templates -->
    <changeSet author="fineract" id="ss-0040-1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM m_template
                WHERE name IN (
                    'SELF_SERVICE_PASSWORD_RENEWED_EMAIL_SUBJECT',
                    'SELF_SERVICE_PASSWORD_RENEWED_EMAIL',
                    'SELF_SERVICE_PASSWORD_RENEWED_SMS',
                    'SELF_SERVICE_PASSWORD_RENEWED_WHATSAPP',
                    'SELF_SERVICE_PASSWORD_RENEWED_IN_APP'
                );
            </sqlCheck>
        </preConditions>

        <comment>Notification templates for PASSWORD_RENEWED event (Email, SMS, WhatsApp, In-App)</comment>

        <!-- ============================================================ -->
        <!-- EMAIL Templates (type = 1)                                   -->
        <!-- ============================================================ -->

        <!-- Email Subject -->
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_PASSWORD_RENEWED_EMAIL_SUBJECT"/>
            <column name="text" value="Tu Contraseña ha sido Restablecida Exitosamente"/>
        </insert>

        <!-- Email Body (HTML) -->
        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_PASSWORD_RENEWED_EMAIL"/>
            <column name="text" value="&lt;p&gt;Hola ${firstname},&lt;/p&gt;&lt;p&gt;Te confirmamos que la contraseña de tu cuenta &lt;strong&gt;${username}&lt;/strong&gt; ha sido restablecida exitosamente.&lt;/p&gt;&lt;p&gt;Si realizaste este cambio, puedes seguir usando tu cuenta con normalidad.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;⚠️ ¿No fuiste tú?&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Si no solicitaste este cambio, por favor contacta inmediatamente a nuestro equipo de soporte o inicia sesión y cambia tu contraseña nuevamente para proteger tu cuenta.&lt;/p&gt;&lt;p&gt;Saludos,&lt;br/&gt;Equipo de Soporte&lt;/p&gt;"/>
        </insert>

        <!-- ============================================================ -->
        <!-- SMS Template (type = 0)                                      -->
        <!-- ============================================================ -->

        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_PASSWORD_RENEWED_SMS"/>
            <column name="text" value="Hola ${firstname}, la contraseña de tu cuenta ${username} ha sido restablecida exitosamente. Si no fuiste tú, contacta inmediatamente a soporte."/>
        </insert>

        <!-- ============================================================ -->
        <!-- WhatsApp Template (type = 0)                                 -->
        <!-- ============================================================ -->

        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="1"/>
            <column name="name" value="SELF_SERVICE_PASSWORD_RENEWED_WHATSAPP"/>
            <column name="text" value="✅ *Contraseña Restablecida Exitosamente*\n\nHola *${firstname}*,\n\nTe confirmamos que la contraseña de tu cuenta *${username}* ha sido cambiada exitosamente.\n\nSi realizaste este cambio, puedes seguir usando tu cuenta con normalidad.\n\n⚠️ *¿No fuiste tú?*\nSi no solicitaste este cambio, por favor contacta inmediatamente a nuestro equipo de soporte para proteger tu cuenta.\n\nSaludos,\n_Equipo de Soporte_"/>
        </insert>

        <!-- ============================================================ -->
        <!-- In-App Template (type = 0)                                   -->
        <!-- ============================================================ -->

        <insert tableName="m_template">
            <column name="entity" valueNumeric="0"/>
            <column name="type" valueNumeric="0"/>
            <column name="name" value="SELF_SERVICE_PASSWORD_RENEWED_IN_APP"/>
            <column name="text" value="La contraseña de tu cuenta ${username} ha sido restablecida exitosamente. Ya puedes iniciar sesión con tu nueva contraseña."/>
        </insert>

        <rollback>
            <delete tableName="m_template">
                <where>
                    name IN (
                        'SELF_SERVICE_PASSWORD_RENEWED_EMAIL_SUBJECT',
                        'SELF_SERVICE_PASSWORD_RENEWED_EMAIL',
                        'SELF_SERVICE_PASSWORD_RENEWED_SMS',
                        'SELF_SERVICE_PASSWORD_RENEWED_WHATSAPP',
                        'SELF_SERVICE_PASSWORD_RENEWED_IN_APP'
                    )
                </where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>