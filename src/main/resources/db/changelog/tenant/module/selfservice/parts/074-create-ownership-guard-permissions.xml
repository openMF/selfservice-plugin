<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!--
        MULTI-TENANT NOTE: This changelog is included in the TENANT changelog master.
        It will be executed against EVERY tenant schema automatically by Fineract's
        multi-tenant Liquibase runner.

        Ensures CREATE_ACCOUNTTRANSFER exists and is granted to the Self Service User
        role. Used by the centralized ownership guard
        (AppSelfServiceUser.validateHasSelfServiceReadPermission()).

        CREATE_ACCOUNTTRANSFER may already exist from core Fineract; the permission
        changeSet is skipped in that case. The grant changeSet still runs when needed.
    -->

    <!-- ========================================================= -->
    <!-- Ensure CREATE_ACCOUNTTRANSFER permission row exists       -->
    <!-- ========================================================= -->
    <changeSet id="ss-0074-1" author="fineract">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="m_permission"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_permission WHERE code = 'CREATE_ACCOUNTTRANSFER'
            </sqlCheck>
        </preConditions>
        <comment>
            Insert CREATE_ACCOUNTTRANSFER only if it does not already exist
            (core Fineract or a previous plugin run may have created it).
        </comment>
        <insert tableName="m_permission">
            <column name="grouping" value="self_service"/>
            <column name="code" value="CREATE_ACCOUNTTRANSFER"/>
            <column name="entity_name" value="ACCOUNTTRANSFER"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- ========================================================= -->
    <!-- Grant CREATE_ACCOUNTTRANSFER to Self Service User role    -->
    <!-- ========================================================= -->
    <changeSet id="ss-0074-2" author="fineract">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="m_role"/>
            <tableExists tableName="m_permission"/>
            <tableExists tableName="m_role_permission"/>
            <!-- Role must exist -->
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_role WHERE name = 'Self Service User'
            </sqlCheck>
            <!-- Permission must exist (from this file or core) -->
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_permission WHERE code = 'CREATE_ACCOUNTTRANSFER'
            </sqlCheck>
            <!-- Grant must not already exist -->
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM m_role_permission rp
                INNER JOIN m_role r ON r.id = rp.role_id
                INNER JOIN m_permission p ON p.id = rp.permission_id
                WHERE r.name = 'Self Service User'
                  AND p.code = 'CREATE_ACCOUNTTRANSFER'
            </sqlCheck>
        </preConditions>
        <comment>
            Grant CREATE_ACCOUNTTRANSFER to the Self Service User role when
            the role and permission exist and the link has not been granted yet.
        </comment>
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT r.id, p.id
            FROM m_role r
            INNER JOIN m_permission p ON p.code = 'CREATE_ACCOUNTTRANSFER'
            WHERE r.name = 'Self Service User'
              AND NOT EXISTS (
                  SELECT 1
                  FROM m_role_permission rp
                  WHERE rp.role_id = r.id
                    AND rp.permission_id = p.id
              )
        </sql>
    </changeSet>

</databaseChangeLog>