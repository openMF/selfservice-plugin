<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!--
        MULTI-TENANT NOTE: This changelog is included in the TENANT changelog master.
        It will be executed against EVERY tenant schema automatically by Fineract's
        multi-tenant Liquibase runner.

        Grants the Self Service User role permissions required by the
        centralized ownership guard. These permissions are checked via
        AppSelfServiceUser.validateHasSelfServiceReadPermission().
    -->

    <!-- ========================================================= -->
    <!-- Ensure CREATE_ACCOUNTTRANSFER permission exists           -->
    <!-- ========================================================= -->
    <changeSet id="ss-0071-2" author="fineract">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_permission"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_permission WHERE code = 'CREATE_ACCOUNTTRANSFER'
            </sqlCheck>
        </preConditions>
        <comment>
            Ensure the Self Service User role has the ACCOUNTTRANSFER CREATE permission
            required by the refactored transfer endpoints.
        </comment>
        <insert tableName="m_permission">
            <column name="grouping" value="self_service"/>
            <column name="code" value="CREATE_ACCOUNTTRANSFER"/>
            <column name="entity_name" value="ACCOUNTTRANSFER"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- ========================================================= -->
    <!-- Grant permission to Self Service User role                -->
    <!-- ========================================================= -->
    <changeSet id="ss-0071-3" author="fineract">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_role"/>
            <tableExists tableName="m_permission"/>
            <tableExists tableName="m_role_permission"/>
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_role WHERE name = 'Self Service User'
            </sqlCheck>
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM m_permission WHERE code = 'CREATE_ACCOUNTTRANSFER'
            </sqlCheck>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM m_role_permission rp
                INNER JOIN m_role r ON r.id = rp.role_id
                INNER JOIN m_permission p ON p.id = rp.permission_id
                WHERE r.name = 'Self Service User'
                  AND p.code = 'CREATE_ACCOUNTTRANSFER'
            </sqlCheck>
        </preConditions>
        <comment>
            Grant ACCOUNTTRANSFER CREATE to the Self Service User role if not already granted.
        </comment>
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT r.id, p.id
            FROM m_role r
            CROSS JOIN m_permission p
            WHERE r.name = 'Self Service User'
              AND p.code = 'CREATE_ACCOUNTTRANSFER'
        </sql>
    </changeSet>

</databaseChangeLog>